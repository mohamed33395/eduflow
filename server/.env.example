# ── EduFlow API — environment template ──────────────────────────────
# Copy to `.env` and fill real values. NEVER commit the real .env.

# ── Required ─────────────────────────────────────────────────────────
# PostgreSQL (Neon or any Postgres). Prisma datasource reads this.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign & verify access JWTs (generate: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed browser origins (credentials: true).
# REQUIRED in production — defaults to localhost only.
CORS_ORIGIN=https://app.yourdomain.com

# ── Recommended for production ───────────────────────────────────────
# Must be "production" on the live server: refresh cookies become
# Secure and dev-only reset tokens stop being returned.
NODE_ENV=production

# Public URL of THIS api — used to build upload presign links.
# Without it upload URLs point at localhost.
API_PUBLIC_URL=https://api.yourdomain.com/api

# Port the API listens on (default 4000).
PORT=3001

# Reverse-proxy trust: "1" trusts one proxy hop (nginx/load balancer).
# Needed so per-IP rate limiting sees real client IPs. "false" if direct.
TRUST_PROXY=1

# ── Optional: token TTLs ─────────────────────────────────────────────
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# ── Optional: uploads ────────────────────────────────────────────────
# Separate secret for signed local-upload URLs (defaults to JWT_ACCESS_SECRET)
# UPLOAD_TOKEN_SECRET=

# Object storage (S3/R2/MinIO). Without these, uploads are stored as
# blobs in Postgres (stored_files table, 50MB cap).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=eduflow
# S3_PUBLIC_URL=

# ── Optional: email (password-reset OTPs, notifications) ─────────────
# Without SMTP the API still works; mail sends are skipped.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="EduFlow <no-reply@yourdomain.com>"

# ── Optional: WhatsApp Cloud API (task results to parents) ───────────
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Copy this file to `.env` and fill in real values.

# PostgreSQL — Neon free tier (recommended: no install) or local Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/eduflow?sslmode=require"
# Local example:
# DATABASE_URL="postgresql://eduflow:eduflow@localhost:5432/eduflow?schema=public"

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Auth — generate strong random secrets for production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# File storage (Phase 5) — S3-compatible (Cloudflare R2 / AWS S3 / MinIO)
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=eduflow
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
